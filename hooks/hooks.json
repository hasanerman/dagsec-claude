{
  "description": "Checks packages with dagsec before an install command runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Bash(npm install *)",
            "server": "plugin:dagsec:dagsec",
            "tool": "check_install",
            "input": {
              "command": "${tool_input.command}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Bash(npm i *)",
            "server": "plugin:dagsec:dagsec",
            "tool": "check_install",
